PORT=4000
# Address this PC is reachable at. Used both to bind and to reach Tally, since they share a PC.
# Loopback keeps :4000 off the office LAN; a LAN address exposes it, guarded only by SHARED_SECRET.
HOST=127.0.0.1
SHARED_SECRET=change-me
# 9001, not Tally's default 9000: the client's server runs one TallyPrime per Windows
# session, and 9000 is already taken by the instance holding their live books.
TALLY_PORT=9001
TALLY_TIMEOUT_MS=30000
DEFAULT_COMPANY=YOUR TALLY COMPANY NAME

# TESTING ONLY. TallyPrime's free Educational version rejects any voucher date other than the
# 1st, 2nd, or last day of a month. Setting this rewrites dates to fit, so a rejection you see is
# a real XML problem rather than a date-policy one. Leave OFF against a licensed Tally.
TALLY_EDU_MODE=false

# TESTING ONLY. Creates any ledger the voucher references but Tally does not have yet (party,
# sales, tax, round-off). Off by default: against a real company a mapping typo would silently
# become a new ledger instead of a loud failure, leaving near-duplicate accounts to clean up.
ALLOW_MASTER_CREATE=false
